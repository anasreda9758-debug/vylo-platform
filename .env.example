# Database (dev: scripts/dev-db.mjs — staging/prod: docker-compose.yml)
DATABASE_URL=postgres://postgres:lms_dev@localhost:5432/lms

# Auth (generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated exact origins only; do not use wildcards.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Logging (info | warn | error in prod; debug in dev)
LOG_LEVEL=info
NODE_ENV=development

# Admin seed (npm run db:seed:admin)
ADMIN_EMAIL=admin@horus.edu.eg
ADMIN_PASSWORD=ChangeMe!Admin2026
ADMIN_NAME=Platform Admin

# AI Tutor (M4) — Groq via @ai-sdk/openai-compatible
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
