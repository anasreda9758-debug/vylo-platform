# PLACEHOLDERS ONLY. Copy on the staging host, never copy local .env credentials.
STAGING_DOMAIN=staging.example.com
BETTER_AUTH_URL=https://staging.example.com
BETTER_AUTH_TRUSTED_ORIGINS=https://staging.example.com
BETTER_AUTH_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_A_SEPARATE_STAGING_PASSWORD
DATABASE_URL=postgres://lms:REPLACE_WITH_URL_ENCODED_STAGING_PASSWORD@db:5432/lms
STAGING_CONTENT_ROOT=/opt/vylo-staging-content
NODE_ENV=production
VYLO_ENVIRONMENT=staging
STORAGE_DRIVER=local
CONTENT_ROOT=/data
USE_HOSTED_AI=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
RESEND_API_KEY=
EMAIL_FROM=
LOG_LEVEL=info
# Intentionally no payment credentials, admin seed password or fixture accounts.
